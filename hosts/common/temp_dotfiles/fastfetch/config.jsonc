{
  "logo": {
    "source": "nixos_small",
    "padding": {
      "right": 2,
			"left": 2,
      "top": 1
    }
  },

  "display": {
    "color": {
      "keys": "blue",
      "title": "cyan"
    },
    "separator": "  →  "
  },

  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}"
    },

    "separator",

    {
      "type": "os",
      "key": "●"
    },
 
    {
      "type": "cpu",
      "key": "▣"
    },
    {
      "type": "gpu",
      "key": "◆"
    },
    {
      "type": "memory",
      "key": "▥"
    },

    "break",

    "player",
		{
			"type": "media",
			"key": "Media",
			"format": "{artist} - {title}",
		},
  ]
}

