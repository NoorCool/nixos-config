{
	"output" : ["eDP-1", "DP-1"],
	"layer": "top",
	"position": "left",
	"mod": "dock",
	"margin-left": 5,
	"margin-top": 50,
	"margin-bottom": 50,
	"exclusive": true,
	"passthrough": false,
	"gtk-layer-shell": true,
	"reload_style_on_change": true,

	"modules-left" : [
		"hyprland/workspaces",
		"network",
	],

	"modules-center" : [
		"clock"
	],

	"modules-right" : [
		"bluetooth",
		"wireplumber",
		"cpu",
		"memory",
		"disk",
		"battery",
	],

	"cpu" : {
		"format" : "CPU",
		"tooltip" : "{usage}%",
		"interval" : 1,
  },

	"disk" : {
		"format" : "DIS",
		"tooltip" : true,
	},

	"memory" : {
		"format" : "MEM",
		"tooltip" : true,
		"tooltip-format" : "{percentage}% - {used:0.1f}GB/{total:0.1f}GB mem",
		"max-length" : 20,
		"interval" : 1,
	},

	"network" : {
		"format-wifi" : "ᯤ",
		"tooltip" : true,
		"tooltip-format" : "{essid} {signalStrength}%",
		"rotate" : 0,
		"format-disconnected" : "no wifi",
	},

	"wireplumber" : {
		"format" : "{icon}",
		"format-muted" : "X",
		"rotate" : 0,
		"tooltip" : true,
		"tooltip-format" : "{volume}",
		"format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
	},

	"bluetooth" : {
		"format" : "ᛒ",
		"format-on" : "ᛒ",
		"format-disabled" : "",
		"on-click" : "bluetoothctl connect F8:AB:E5:68:D6:52",
		"tooltip" : true,
		"tooltip-format" : "{status}",
		"tooltip-format-on" : "{status}",
		"tooltip-format-connected" : "{device_alias} {device_battery_percentage}%",
		"interval" : 1,
	},

	"hyprland/workspaces" : {
		"format" : "{icon}",
		"on-click" : "activate",
		"format-icons" : {
			"1" : "1",
		},
		"all-outputs" : true,
		"active" : " ",
		"sort-by-number" : true
	},

	"battery" : {
		"states" : {
			"good" : 100,
			"warning" : 30,
			"critical" : 20
		},
		"format" : "{capacity}%",
		"rotate" : 0,
		"format-charging" : "⚡",
		"format-plugged" : "AC",
		"format-alt" : "{time}",
		"tooltip-format" : "{capacity}%",
	},

	"clock" : {
		"interval" : 1,
		"format" : "{:%H\n%M\n%S}",
		"tooltip-format" : "{:%A, %d %B %Y}",
	},
}

